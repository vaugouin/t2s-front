# Runtime configuration of the front. EXAMPLE FILE: copy it to .env, beside html/ and lib/,
# and replace every placeholder. .env is ignored by git and must never be committed.
#
# lib/env.inc.php loads this file (lib/../.env). A variable already present in the process
# environment (PHP-FPM pool, container) wins over the value written here.
#
# The database accounts and the TMDb keys are not here: see lib/database/*.example.

# URL prefixes under which the pages are served. Each entry is prefix:language, followed by
# :private when the prefix is a private one. Languages: en, fr. Every prefix is an alias or a
# link to html/app/, created on the web server. A request under a prefix that is not listed is
# public and uses T2S_DEFAULT_LANG. The private prefixes MUST be put behind authentication by the
# web server: the application authenticates nobody.
T2S_URL_PREFIXES=/en/:en,/fr/:fr,/staff/:en:private
T2S_DEFAULT_LANG=en

# Canonical public base URL of the site, without a trailing slash. Used to build the absolute
# URLs of the social preview tags (og:url, og:image). Optional: without it those tags are left out.
SITE_BASE_URL=https://www.example.com

# Name of the site, shown in the page titles, the social preview tags and the About page.
# Optional: "T2S" when it is not set.
SITE_NAME=T2S

# Address of the public source repository, shown on the About page. Optional: without it the
# About page has no "Source code" section.
#SITE_REPOSITORY_URL=https://example.com/your/repository

# Text2SQL API (Blue and Green deployments). The colour in service is set in
# lib/global-light.inc.php ($strtext2sqlapicolor).
TEXT2SQL_API_BLUE_URL=http://your_api_host:8010
TEXT2SQL_API_GREEN_URL=http://your_api_host:8011
# Name and value of the HTTP header that carries the API key. The key stays on the server:
# the browser never sees it.
TEXT2SQL_API_KEY_NAME=X-API-Key
TEXT2SQL_API_KEY_VALUE=your_api_key_value
# Seconds the front waits for /search/text2sql before it shows a timeout message.
# Optional, default 90.
TEXT2SQL_TIMEOUT_SECONDS=90

# Plugins: folder scanned for plugins in private mode. Optional, default plugins/ beside html/
# and lib/. A plugin may read settings of its own from this file: see its documentation.
#T2S_PLUGINS_DIR=/path/to/plugins

# Explicit close of every MariaDB connection at the end of the script. 1 is the default,
# applied when the variable is absent. Set it to 0 to let PHP free the handles on its own.
#T2S_MYSQL_AUTOCLOSE=1

# Command-line runs only (php lib/... from a shell): values that stand in for the web server
# variables. T2S_DOCUMENT_ROOT is the absolute path of html/ with a trailing slash;
# T2S_HTTP_HOST is the host name f_env() should see. Any other server variable can be
# given the same way, as T2S_<NAME>.
#T2S_DOCUMENT_ROOT=/path/to/t2s-front/html/
#T2S_HTTP_HOST=www.example.com
