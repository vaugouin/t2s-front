# Text files are stored and checked out with LF line endings.
*.php      text eol=lf
*.example  text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.svg      text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf
VERSION        text eol=lf
LICENSE        text eol=lf

# Binary assets are never converted.
*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
