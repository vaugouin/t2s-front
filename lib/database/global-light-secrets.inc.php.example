<?php
//Secrets and environment switch of the front. EXAMPLE FILE: copy it to
//lib/database/global-light-secrets.inc.php and replace every placeholder.
//The copy is ignored by git (.gitignore) and must never be committed.
//
//Included by lib/global-light.inc.php, before the database connection is opened.

//TMDb API (https://developer.themoviedb.org). The token is the "API Read Access Token" (v4),
//sent as a Bearer header; the key is the v3 key, used only when $inttmdbuseapikey is 1.
$strtmdbapikey="YOUR_TMDB_API_KEY";
$strtmdbapitoken="YOUR_TMDB_API_READ_ACCESS_TOKEN";
$inttmdbuseapikey=0;
$strtmdbapirequesttoken="";
$strtmdbcurrentusername="YOUR_TMDB_USERNAME";

//The Text2SQL API settings are read from .env (TEXT2SQL_API_BLUE_URL, TEXT2SQL_API_GREEN_URL,
//TEXT2SQL_API_KEY_NAME, TEXT2SQL_API_KEY_VALUE). The four variables $strtext2sqlapibluedomainurl,
//$strtext2sqlapigreendomainurl, $strtext2sqlapikeyname and $strtext2sqlapikeyvalue may be set
//here instead: global-light.inc.php uses them only when the matching .env variable is absent.

if (!isset($intdbreadwrite)) {
	$intdbreadwrite=false;
}

function f_env() {
	//Purpose: Name of the environment, decided from the host name of the request
	//Returns: the key of the switch below, which picks the file holding the database account
	//Always build the conditions so that the default environment is the one in service.
	//Web server
	$strhttphost=strtolower(f_php_server_var("HTTP_HOST"));
	$lngpos=strpos($strhttphost,":");
	if ($lngpos!==false)
	{
		$strhttphost=substr($strhttphost,0,$lngpos);
	}
	switch ($strhttphost) {
	case "example.com":
	case "www.example.com":
		//The site itself
		return "MAIN";
		break;
	//To run a second environment (a staging host with its own database, for instance), add its
	//host names here, return another key, and include another credentials file in the switch below.
	default:
		return "MAIN";
		break;
	}
}

//Environment variables
$strenv=f_env();

switch ($strenv)
{
case "MAIN":
default:
	//$intdebug=1;
	include(__DIR__."/database.inc.php");
	break;
}

?>
